+	/** Observe only the native selected cache, without refreshing it or retaining a prior scope. */
+	getQuotaSnapshot(session: TSession = this.session): StatusLineQuota {
+		if (
+			this.#disposed ||
+			session !== this.session ||
+			this.#cachedUsageContextKey !== this.#getUsageContextKey(session)
+		)
+			return { status: "unavailable" };
+		const usage = this.#cachedUsage;
+		const window = (value: { percent: number; resetsAt?: number } | undefined) =>
+			value && Number.isFinite(value.percent)
+				? { remainingFraction: 1 - value.percent / 100, resetsAt: value.resetsAt }
+				: undefined;
+		const fiveHour = window(usage?.fiveHour);
