+/** The same model policy and trigger resolver used by automatic compaction. */
+export function getSessionCompactionBudget(
+	settings: ScopeLike,
+	contextWindow: number,
+	model?: Model | null,
+): StatusLineMetrics["compaction"] {
+	const configured: CompactionSettings = resolveModelCompactionSettings(settings, model);
+	if (!configured.enabled || configured.strategy === "off") return { status: "disabled" };
+	if (!Number.isFinite(contextWindow) || !(contextWindow > 0)) return { status: "unavailable" };
+	const thresholdTokens = resolveThresholdTokens(contextWindow, configured);
+	if (!Number.isFinite(thresholdTokens) || !(thresholdTokens > 0) || thresholdTokens > contextWindow) {
+		return { status: "unavailable" };
+	}
+	return { status: "enabled", thresholdTokens };
+}
