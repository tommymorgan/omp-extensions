@@ -0,0 +1,47 @@
+import { describe, expect, it } from "bun:test";
+import { resolveThresholdTokens } from "@oh-my-pi/pi-agent-core/compaction";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { getSessionCompactionBudget } from "@oh-my-pi/pi-coding-agent/session/context-usage-runtime";
+import { resolveModelCompactionSettings } from "@oh-my-pi/pi-coding-agent/session/model-compaction-threshold";
+
+const model = createMockModel({ id: "metrics", provider: "openai", contextWindow: 500_000 });
+
+describe("read-only compaction metrics", () => {
+	it("reports the exact central trigger for global and model-specific policies", () => {
+		const variants = [
+			Settings.isolated({ "compaction.thresholdTokens": 300_000, "compaction.thresholdPercent": -1 }),
+			Settings.isolated({
+				"compaction.thresholdTokens": -1,
+				"compaction.thresholdPercent": 80,
+				"compaction.reserveTokens": 20_000,
+			}),
+			Settings.isolated({
+				"compaction.modelThresholds": { "openai/metrics": 300_000 },
+				"compaction.thresholdPercent": 80,
+				"compaction.reserveTokens": 20_000,
+			}),
+			Settings.isolated({ "compaction.modelThresholds": { "openai/metrics": "f230000" } }),
+		];
+		for (const settings of variants) {
+			const revision = settings.revision;
+			const trigger = resolveThresholdTokens(model.contextWindow, resolveModelCompactionSettings(settings, model));
+			for (let i = 0; i < 10; i++) {
+				expect(getSessionCompactionBudget(settings, model.contextWindow, model)).toEqual({
+					status: "enabled",
+					thresholdTokens: trigger,
+				});
+			}
+			expect(settings.revision).toBe(revision);
+		}
+	});
+
+	it("distinguishes off policy from unusable capacity without inventing a number", () => {
+		expect(getSessionCompactionBudget(Settings.isolated({ "compaction.enabled": false }), 500_000, model)).toEqual({
+			status: "disabled",
+		});
+		for (const capacity of [0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
+			expect(getSessionCompactionBudget(Settings.isolated(), capacity, model)).toEqual({ status: "unavailable" });
+		}
+	});
+});
